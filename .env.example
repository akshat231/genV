PORT=5000
HOST=localhost

# LLM VARIABLES
IDEA_MODEL=gpt-6-luna
SCRIPT_MODEL=gpt-6.1-sol
VOICEOVER_MODEL=gpt-4o-mini-tts
TRANSCRIPTION_MODEL=whisper-1
SCENE_MODEL=gpt-6.1-sol
IMAGE_MODEL=gpt-image-2
CHAT_API_KEY=<openai-api-key>
CHAT_MODEL_PROVIDER=openai

//VOICEOVER VARIABLES
VOICEOVER_PARENT_DIRECTORY=<folder-path>
VOICE_TEXTURE=coral

# IMAGE VARIABLES
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_FORMAT=jpeg
IMAGE_CONCURRENCY=4

#VIDEO VARIABLES
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_FADE_SEC=0.5
VIDEO_CAPTION_STYLE=FontSize=14,Bold=1,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=2,Shadow=0,MarginV=50,Alignment=2;